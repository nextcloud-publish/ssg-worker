# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'

# These have no default in .env (see config/services.yaml). Kernel tests compile
# the container and may instantiate services that need them, so they point at a
# path nothing creates. Tests that use the filesystem create their own temp
# directory and construct the classes directly.
JOB_STORAGE_DIR=/tmp/ssg-worker-test-unused/build_temp
PUBLISHED_DIR=/tmp/ssg-worker-test-unused/published
MAX_DOWNLOAD_MB=256
PUBLISH_BASE_URL=http://sites.test
