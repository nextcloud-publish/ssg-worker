# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'

# The three storage roots have no defaults in .env on purpose (see
# services.yaml): a missing value in a real deployment must fail loudly. A
# kernel test still has to compile the container and can instantiate services
# that need them, so point them somewhere nothing creates -- every test that
# actually touches the filesystem builds its own temp tree and constructs these
# classes directly.
JOB_STORAGE_DIR=/tmp/ssg-worker-test-unused/build_temp
PUBLISHED_DIR=/tmp/ssg-worker-test-unused/published
MAX_DOWNLOAD_MB=256
